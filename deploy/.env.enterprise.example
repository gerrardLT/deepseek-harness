# DeepSeek Harness + WorkFusion Enterprise Private Deployment Environment Template

# ── Database ──
POSTGRES_PASSWORD=generate_a_strong_password_here

# ── WorkFusion Authentication & Delegation ──
JWT_SECRET_KEY=generate_a_strong_jwt_secret_at_least_32_characters
# Optional: dedicated delegation signing key; defaults to HMAC derived from JWT_SECRET_KEY
# DELEGATION_JWT_SECRET=optional_dedicated_delegation_secret

# ── Inter-Service Authentication (DSH <-> WorkFusion) ──
# DSH exchanges this token for short-lived (15-min) scoped delegation tokens
DSH_SERVICE_TOKEN=generate_a_strong_service_token_at_least_32_characters
BID_DELEGATION_SUBJECT=admin

# ── AI Model Providers ──
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DASHSCOPE_API_KEY=sk-your_dashscope_api_key_for_qwen_long
